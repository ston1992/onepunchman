# --- Required ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=

# Written by `npm run setup:cloud -w @twinly/server`.
TWIN_ENVIRONMENT_ID=
TWIN_AGENT_ID=

# --- Optional ---------------------------------------------------------------
PORT=8787
# Public base URL of this server (Stripe redirect pages live here).
PUBLIC_URL=http://localhost:8787
DATABASE_PATH=twinly.db
# Hard spend cap per task, in US cents ("500" = $5.00).
TWIN_TASK_BUDGET_CENTS=500

# Stripe. Leave STRIPE_SECRET_KEY empty to run without billing (everyone on Free).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# Email (verification + password reset) through Resend. Leave empty in dev:
# nothing is sent and new accounts are auto-verified.
RESEND_API_KEY=
EMAIL_FROM=Twinly <hello@twinly.app>
